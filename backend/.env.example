# ─────────────────────────────────────────────────────────────────────────────
# AI Form Filler — backend/.env
# Copy this file to backend/.env and fill in the values below.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-real-secret-key

# PostgreSQL — matches the docker-compose service name "db"
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/formfiller

# ── Google Document AI ────────────────────────────────────────────────────────
#
# IMPORTANT: If using ADC (gcloud auth application-default login),
# do NOT include the GOOGLE_APPLICATION_CREDENTIALS line at all,
# OR comment it out. An empty value causes a startup crash.
#
# Option A — ADC via gcloud (recommended, no key file):
#   Comment out or DELETE the line below entirely.
#
# Option B — Service account key file:
#   Uncomment and set the path below.
#
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp-service-account.json

# Your GCP project NUMBER (integer, not the string project ID)
GOOGLE_CLOUD_PROJECT_ID=123456789012

# Region where you created the Form Parser processor (us or eu)
GOOGLE_CLOUD_LOCATION=us

# Processor ID from console.cloud.google.com/ai/document-ai/processors
GOOGLE_DOCUMENTAI_PROCESSOR_ID=abc1234567890def

MAX_UPLOAD_SIZE_MB=20
